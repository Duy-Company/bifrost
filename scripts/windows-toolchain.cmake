set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
get_filename_component(BIFROST_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(CMAKE_C_COMPILER "${BIFROST_ROOT}/vendor/toolchain/bin/x86_64-w64-mingw32-clang")
set(CMAKE_CXX_COMPILER "${BIFROST_ROOT}/vendor/toolchain/bin/x86_64-w64-mingw32-clang++")
set(CMAKE_RC_COMPILER "${BIFROST_ROOT}/vendor/toolchain/bin/x86_64-w64-mingw32-windres")
set(CMAKE_FIND_ROOT_PATH "${BIFROST_ROOT}/vendor/sysroot/ucrt64" "${BIFROST_ROOT}/vendor/toolchain/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_C_FLAGS_INIT "-I${BIFROST_ROOT}/vendor/sysroot/ucrt64/include")
set(CMAKE_CXX_FLAGS_INIT "-I${BIFROST_ROOT}/vendor/sysroot/ucrt64/include")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-L${BIFROST_ROOT}/vendor/sysroot/ucrt64/lib")
